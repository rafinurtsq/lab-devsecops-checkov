# =============================================================================
# .dockerignore - File yang dikecualikan dari Docker build context
# PENTING: Selalu gunakan .dockerignore untuk keamanan!
# =============================================================================

# File sensitif - JANGAN pernah masuk ke dalam image
.env
.env.*
*.env
secrets/
credentials/
*.pem
*.key
*.crt
*.p12
*.pfx

# Direktori Git
.git/
.gitignore

# File konfigurasi lokal
*.local
docker-compose*.yml
docker-compose*.yaml
Dockerfile*
.dockerignore

# File testing
tests/
test/
*_test.py
*.test.js

# Dokumentasi
*.md
docs/
README*

# Cache dan temporary files
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/
.venv/
venv/
env/
node_modules/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
